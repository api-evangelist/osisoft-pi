          "name": "List PI points on a server",
          "request": {
            "name": "List PI points on a server",
            "description": {
              "content": "Returns PI points (tags) on the specified PI Data Archive server with optional name filtering.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dataservers",
                ":webId",
                "points"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "nameFilter",
                  "value": "<string>",
                  "description": "Wildcard filter for tag names (e.g. *.FLOW)"
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filter by point type"
                },
                {
                  "disabled": false,
                  "key": "maxCount",
                  "value": "1000"
                },
                {
                  "disabled": false,
                  "key": "startIndex",
                  "value": "0"
                },
                {
                  "disabled": false,
                  "key": "selectedFields",
                  "value": "<string>"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "webId",
                  "description": "(Required) PI Web API WebId (unique opaque identifier for PI System objects)"
                },
                {
                  "description": "PI Web API server hostname",
                  "type": "any",
                  "value": "{{piwebapi_host}}",
                  "key": "piwebapi_host"
                }
